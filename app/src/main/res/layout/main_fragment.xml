<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wqx_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wqx_chassis_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/ToolbarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/toolbar_height">

        <ImageView
            android:id="@+id/toolbar_logo"
            android:layout_width="@dimen/toolbar_icon_width"
            android:layout_height="@dimen/toolbar_icon_height"
            android:layout_marginEnd="@dimen/toolbar_icon_margin_end"
            android:background="@drawable/wqx_icon_frame"
            android:clipToOutline="true"
            android:contentDescription="@string/app_name"
            android:padding="1dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/textColorSecondary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </com.google.android.material.appbar.MaterialToolbar>

    <LinearLayout
        android:id="@+id/emulator_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="5dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <!-- Upper Clamshell Screen Lid -->
        <LinearLayout
            android:id="@+id/upper_lid_panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/wqx_upper_lid_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <!-- Molded Top Speaker / Louver Detail -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.35"
                    android:text="•••••"
                    android:textColor="@color/wqx_grille_dot"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:letterSpacing="0.16"
                    android:text="GOLDEN GLOBAL"
                    android:textColor="@color/wqx_brand_secondary"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.35"
                    android:text="•••••"
                    android:textColor="@color/wqx_grille_dot"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Stepped Molded Lid Recess -->
            <LinearLayout
                android:id="@+id/lid_recess_frame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/wqx_lid_recess_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <!-- Acrylic Dark Metallic Screen Lens (with integrated WQX NC1020 Silkscreen) -->
                <LinearLayout
                    android:id="@+id/lcd_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/wqx_lcd_bezel_bg"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="9dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="7dp">

                    <LinearLayout
                        android:id="@+id/wqx_brand_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="7dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.12"
                            android:text="文曲星"
                            android:textColor="@color/wqx_lens_brand_text"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:background="@drawable/wqx_brand_badge_bg"
                            android:letterSpacing="0.08"
                            android:paddingStart="6dp"
                            android:paddingTop="1dp"
                            android:paddingEnd="6dp"
                            android:paddingBottom="1dp"
                            android:text="NC1020"
                            android:textColor="@color/wqx_brand_badge_text"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:letterSpacing="0.08"
                            android:singleLine="true"
                            android:text="POCKET DICTIONARY"
                            android:textColor="@color/wqx_lens_sub_text"
                            android:textSize="8.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/lcd_well"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/wqx_lcd_well_bg"
                        android:padding="3dp">

                        <SurfaceView
                            android:id="@+id/lcd_surface"
                            android:layout_width="0dp"
                            android:layout_height="0dp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/info_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:singleLine="true"
                        android:textColor="@color/wqx_bezel_info_text"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 3D Cylindrical Clamshell Hinge -->
        <View
            android:id="@+id/wqx_hinge"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/wqx_hinge_barrel" />

        <!-- Lower Clamshell Keyboard Deck -->
        <LinearLayout
            android:id="@+id/lower_deck_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/wqx_lower_deck_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp">

            <org.liberty.android.nc1020emu.KeypadLayout
                android:id="@+id/keypad_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Molded Front Clamshell Latch Indent -->
            <View
                android:layout_width="56dp"
                android:layout_height="5dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/wqx_chin_latch_bg" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
