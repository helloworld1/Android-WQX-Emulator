<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wqx_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wqx_chassis_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/ToolbarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/toolbar_height">

        <ImageView
            android:id="@+id/toolbar_logo"
            android:layout_width="@dimen/toolbar_icon_width"
            android:layout_height="@dimen/toolbar_icon_height"
            android:layout_marginEnd="@dimen/toolbar_icon_margin_end"
            android:background="@drawable/wqx_icon_frame"
            android:clipToOutline="true"
            android:contentDescription="@string/app_name"
            android:padding="1dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/textColorSecondary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </com.google.android.material.appbar.MaterialToolbar>

    <LinearLayout
        android:id="@+id/emulator_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="5dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <!-- Upper Clamshell Lid (Royal-Blue Rim + Top Clasp + Pearl Faceplate) -->
        <org.liberty.android.nc1020emu.WqxUpperLidLayout
            android:id="@+id/upper_lid_panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.39"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="13dp"
            android:paddingEnd="12dp"
            android:paddingBottom="9dp">

            <!-- Top Silkscreen Row: Italic Serif "NC 1020" + Subtle Telemetry -->
            <LinearLayout
                android:id="@+id/wqx_brand_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="NC 1020"
                    android:textColor="@color/wqx_nc1020_serif"
                    android:textSize="14sp"
                    android:textStyle="bold|italic"
                    android:typeface="serif" />

                <TextView
                    android:id="@+id/info_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textColor="@color/wqx_bezel_info_text"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Cool Silver-Grey Screen Bezel: [LCD + 1..9 Strip] | [F1..F4 Sky-Blue Pills] -->
            <LinearLayout
                android:id="@+id/lcd_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/wqx_lcd_bezel_bg"
                android:baselineAligned="false"
                android:gravity="top"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:id="@+id/lcd_left_column"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/lcd_well"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/wqx_lcd_well_bg"
                        android:padding="2dp">

                        <SurfaceView
                            android:id="@+id/lcd_surface"
                            android:layout_width="0dp"
                            android:layout_height="0dp" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/lcd_bezel_numbers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="1" android:textColor="@color/wqx_bezel_num_text" android:textSize="10.5sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="2" android:textColor="@color/wqx_bezel_num_text" android:textSize="10.5sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="3" android:textColor="@color/wqx_bezel_num_text" android:textSize="10.5sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="4" android:textColor="@color/wqx_bezel_num_text" android:textSize="10.5sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="5" android:textColor="@color/wqx_bezel_num_text" android:textSize="10.5sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="6" android:textColor="@color/wqx_bezel_num_text" android:textSize="10.5sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="7" android:textColor="@color/wqx_bezel_num_text" android:textSize="10.5sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="8" android:textColor="@color/wqx_bezel_num_text" android:textSize="10.5sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="9" android:textColor="@color/wqx_bezel_num_text" android:textSize="10.5sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Right-Side Vertical Function Key Column (F1..F4) -->
                <LinearLayout
                    android:id="@+id/fn_keys_column"
                    android:layout_width="@dimen/function_keypad_width"
                    android:layout_height="130dp"
                    android:layout_marginStart="5dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/btn_f1"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/keypad_button"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:duplicateParentState="true"
                            android:singleLine="true"
                            android:text="F1 插入"
                            android:textColor="@color/wqx_fn_label_text"
                            android:textSize="@dimen/function_label_text_size"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="@dimen/function_pill_width"
                            android:layout_height="@dimen/function_pill_height"
                            android:background="@drawable/wqx_fn_pill_button"
                            android:duplicateParentState="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_f2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/keypad_button"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:duplicateParentState="true"
                            android:singleLine="true"
                            android:text="F2 删除"
                            android:textColor="@color/wqx_fn_label_text"
                            android:textSize="@dimen/function_label_text_size"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="@dimen/function_pill_width"
                            android:layout_height="@dimen/function_pill_height"
                            android:background="@drawable/wqx_fn_pill_button"
                            android:duplicateParentState="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_f3"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/keypad_button"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:duplicateParentState="true"
                            android:singleLine="true"
                            android:text="F3 查找"
                            android:textColor="@color/wqx_fn_label_text"
                            android:textSize="@dimen/function_label_text_size"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="@dimen/function_pill_width"
                            android:layout_height="@dimen/function_pill_height"
                            android:background="@drawable/wqx_fn_pill_button"
                            android:duplicateParentState="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_f4"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/keypad_button"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:duplicateParentState="true"
                            android:singleLine="true"
                            android:text="F4 修改"
                            android:textColor="@color/wqx_fn_label_text"
                            android:textSize="@dimen/function_label_text_size"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="@dimen/function_pill_width"
                            android:layout_height="@dimen/function_pill_height"
                            android:background="@drawable/wqx_fn_pill_button"
                            android:duplicateParentState="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Pearl-White Chin: "文曲星® 真人发音" Emblem + Recessed Circular ON/OFF -->
            <LinearLayout
                android:id="@+id/lid_chin_row"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:minHeight="@dimen/lid_chin_min_height"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="8dp">

                <org.liberty.android.nc1020emu.WqxBrandEmblemView
                    android:id="@+id/wqx_chin_emblem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <org.liberty.android.nc1020emu.WqxOnOffButtonView
                    android:id="@+id/btn_onoff"
                    android:layout_width="@dimen/onoff_assembly_size"
                    android:layout_height="@dimen/onoff_assembly_size" />
            </LinearLayout>
        </org.liberty.android.nc1020emu.WqxUpperLidLayout>

        <!-- Two-Tone Pearl & Royal-Blue Cylindrical Clamshell Hinge -->
        <org.liberty.android.nc1020emu.WqxHingeView
            android:id="@+id/wqx_hinge"
            android:layout_width="match_parent"
            android:layout_height="19dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="1dp" />

        <!-- Lower Clamshell Base (Speaker Grille + Clean Vector 5x10 Keypad + Blue Latch) -->
        <LinearLayout
            android:id="@+id/lower_deck_panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.61"
            android:background="@drawable/wqx_lower_deck_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="7dp"
            android:paddingEnd="8dp"
            android:paddingBottom="7dp">

            <org.liberty.android.nc1020emu.WqxSpeakerGrilleView
                android:id="@+id/wqx_speaker_grille"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="5dp"
                android:layout_weight="0.21" />

            <org.liberty.android.nc1020emu.KeypadLayout
                android:id="@+id/keypad_layout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.79" />

            <View
                android:layout_width="40dp"
                android:layout_height="7dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/wqx_chin_latch_bg" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
