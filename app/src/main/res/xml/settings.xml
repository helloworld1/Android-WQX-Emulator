<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.preference.SwitchPreferenceCompat
        app:key="save_states"
        app:title="@string/save_states_setting"
        app:summaryOn="@string/save_states_setting_summary_on"
        app:summaryOff="@string/save_states_setting_summary_off"
        app:defaultValue="true"/>

    <androidx.preference.SwitchPreferenceCompat
        app:key="enable_beep"
        app:title="@string/enable_beep_setting"
        app:summaryOn="@string/enable_beep_setting_summary_on"
        app:summaryOff="@string/enable_beep_setting_summary_off"
        app:defaultValue="true"/>

    <androidx.preference.SwitchPreferenceCompat
        app:key="show_lcd_status"
        app:title="@string/show_lcd_status_setting"
        app:summaryOn="@string/show_lcd_status_setting_summary_on"
        app:summaryOff="@string/show_lcd_status_setting_summary_off"
        app:defaultValue="true"/>

    <androidx.preference.SwitchPreferenceCompat
        app:key="show_pixel_grid"
        app:title="@string/show_pixel_grid_setting"
        app:summaryOn="@string/show_pixel_grid_setting_summary_on"
        app:summaryOff="@string/show_pixel_grid_setting_summary_off"
        app:defaultValue="true"/>

    <androidx.preference.ListPreference
        app:key="vibration"
        app:title="@string/vibration_setting_title"
        app:entries="@array/vibration_entries"
        app:entryValues="@array/vibration_values"
        app:defaultValue="low"
        app:useSimpleSummaryProvider="true"/>

    <androidx.preference.ListPreference
        app:key="skin"
        app:title="@string/skin_setting_title"
        app:entries="@array/skin_entries"
        app:entryValues="@array/skin_values"
        app:defaultValue="authentic"
        app:useSimpleSummaryProvider="true"/>

    <androidx.preference.ListPreference
        app:key="theme"
        app:title="@string/theme_setting_title"
        app:entries="@array/theme_entries"
        app:entryValues="@array/theme_values"
        app:defaultValue="system"
        app:useSimpleSummaryProvider="true"/>

    <androidx.preference.Preference
        app:key="about"
        app:title="@string/about"/>
</androidx.preference.PreferenceScreen>