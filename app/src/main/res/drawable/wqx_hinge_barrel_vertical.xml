<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <gradient
                android:angle="0"
                android:startColor="@color/wqx_hinge_top"
                android:centerColor="@color/wqx_hinge_highlight"
                android:endColor="@color/wqx_hinge_bottom" />
            <stroke
                android:width="1dp"
                android:color="@color/wqx_hinge_seam" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:top="28dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <size android:height="2dp" />
            <solid android:color="@color/wqx_hinge_seam" />
        </shape>
    </item>
    <item
        android:gravity="bottom"
        android:bottom="28dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <size android:height="2dp" />
            <solid android:color="@color/wqx_hinge_seam" />
        </shape>
    </item>
</layer-list>
