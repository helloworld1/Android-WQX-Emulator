<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="14dp"
                android:topRightRadius="14dp"
                android:bottomLeftRadius="6dp"
                android:bottomRightRadius="6dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/wqx_lid_surface_start"
                android:centerColor="@color/wqx_lid_surface_center"
                android:endColor="@color/wqx_lid_surface_end" />
            <stroke
                android:width="1dp"
                android:color="@color/wqx_lid_stroke_dark" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="13dp"
                android:topRightRadius="13dp"
                android:bottomLeftRadius="5dp"
                android:bottomRightRadius="5dp" />
            <stroke
                android:width="1dp"
                android:color="@color/wqx_lid_stroke_light" />
        </shape>
    </item>
</layer-list>
