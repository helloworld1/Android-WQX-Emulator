<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cylindrical metallic hinge barrel -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/wqx_hinge_top"
                android:centerColor="@color/wqx_hinge_highlight"
                android:endColor="@color/wqx_hinge_bottom" />
            <stroke
                android:width="1dp"
                android:color="@color/wqx_hinge_seam" />
        </shape>
    </item>
    <!-- Left hinge knuckle seam -->
    <item
        android:gravity="start"
        android:left="36dp"
        android:top="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <size android:width="2dp" />
            <solid android:color="@color/wqx_hinge_seam" />
        </shape>
    </item>
    <!-- Right hinge knuckle seam -->
    <item
        android:gravity="end"
        android:right="36dp"
        android:top="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <size android:width="2dp" />
            <solid android:color="@color/wqx_hinge_seam" />
        </shape>
    </item>
</layer-list>
