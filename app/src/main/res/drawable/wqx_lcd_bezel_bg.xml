<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/wqx_bezel_start"
                android:endColor="@color/wqx_bezel_end" />
            <stroke
                android:width="1.5dp"
                android:color="@color/wqx_bezel_stroke" />
        </shape>
    </item>
</layer-list>
