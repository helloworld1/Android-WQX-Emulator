<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/wqx_fn_pill_pressed_top"
                android:endColor="@color/wqx_fn_pill_pressed_bottom" />
            <stroke
                android:width="1.2dp"
                android:color="@color/wqx_fn_pill_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/wqx_fn_pill_top"
                android:endColor="@color/wqx_fn_pill_bottom" />
            <stroke
                android:width="1.2dp"
                android:color="@color/wqx_fn_pill_stroke" />
        </shape>
    </item>
</selector>
