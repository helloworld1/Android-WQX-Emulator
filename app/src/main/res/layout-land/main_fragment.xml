<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wqx_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wqx_chassis_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/ToolbarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/toolbar_height">

        <ImageView
            android:id="@+id/toolbar_logo"
            android:layout_width="@dimen/toolbar_icon_width"
            android:layout_height="@dimen/toolbar_icon_height"
            android:layout_marginEnd="@dimen/toolbar_icon_margin_end"
            android:background="@drawable/wqx_icon_frame"
            android:clipToOutline="true"
            android:contentDescription="@string/app_name"
            android:padding="1dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/textColorSecondary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </com.google.android.material.appbar.MaterialToolbar>

    <LinearLayout
        android:id="@+id/emulator_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="5dp">

        <!-- Left Clamshell Screen Lid -->
        <org.liberty.android.nc1020emu.WqxUpperLidLayout
            android:id="@+id/upper_lid_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.47"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp">

            <LinearLayout
                android:id="@+id/wqx_brand_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="3dp"
                android:paddingEnd="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="NC 1020"
                    android:textColor="@color/wqx_nc1020_serif"
                    android:textSize="12.5sp"
                    android:textStyle="bold|italic"
                    android:typeface="serif" />

                <TextView
                    android:id="@+id/info_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textColor="@color/wqx_bezel_info_text"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lcd_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/wqx_lcd_bezel_bg"
                android:baselineAligned="false"
                android:gravity="top"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingTop="6dp"
                android:paddingEnd="5dp"
                android:paddingBottom="5dp">

                <LinearLayout
                    android:id="@+id/lcd_left_column"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/lcd_well"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/wqx_lcd_well_bg"
                        android:padding="2dp">

                        <SurfaceView
                            android:id="@+id/lcd_surface"
                            android:layout_width="0dp"
                            android:layout_height="0dp" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/lcd_bezel_numbers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="1" android:textColor="@color/wqx_bezel_num_text" android:textSize="9.5sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="2" android:textColor="@color/wqx_bezel_num_text" android:textSize="9.5sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="3" android:textColor="@color/wqx_bezel_num_text" android:textSize="9.5sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="4" android:textColor="@color/wqx_bezel_num_text" android:textSize="9.5sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="5" android:textColor="@color/wqx_bezel_num_text" android:textSize="9.5sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="6" android:textColor="@color/wqx_bezel_num_text" android:textSize="9.5sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="7" android:textColor="@color/wqx_bezel_num_text" android:textSize="9.5sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="8" android:textColor="@color/wqx_bezel_num_text" android:textSize="9.5sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="9" android:textColor="@color/wqx_bezel_num_text" android:textSize="9.5sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fn_keys_column"
                    android:layout_width="@dimen/function_keypad_width"
                    android:layout_height="110dp"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/btn_f1"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/keypad_button"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="1dp"
                            android:duplicateParentState="true"
                            android:singleLine="true"
                            android:text="F1 插入"
                            android:textColor="@color/wqx_fn_label_text"
                            android:textSize="@dimen/function_label_text_size"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="@dimen/function_pill_width"
                            android:layout_height="@dimen/function_pill_height"
                            android:background="@drawable/wqx_fn_pill_button"
                            android:duplicateParentState="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_f2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/keypad_button"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="1dp"
                            android:duplicateParentState="true"
                            android:singleLine="true"
                            android:text="F2 删除"
                            android:textColor="@color/wqx_fn_label_text"
                            android:textSize="@dimen/function_label_text_size"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="@dimen/function_pill_width"
                            android:layout_height="@dimen/function_pill_height"
                            android:background="@drawable/wqx_fn_pill_button"
                            android:duplicateParentState="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_f3"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/keypad_button"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="1dp"
                            android:duplicateParentState="true"
                            android:singleLine="true"
                            android:text="F3 查找"
                            android:textColor="@color/wqx_fn_label_text"
                            android:textSize="@dimen/function_label_text_size"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="@dimen/function_pill_width"
                            android:layout_height="@dimen/function_pill_height"
                            android:background="@drawable/wqx_fn_pill_button"
                            android:duplicateParentState="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_f4"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/keypad_button"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="1dp"
                            android:duplicateParentState="true"
                            android:singleLine="true"
                            android:text="F4 修改"
                            android:textColor="@color/wqx_fn_label_text"
                            android:textSize="@dimen/function_label_text_size"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="@dimen/function_pill_width"
                            android:layout_height="@dimen/function_pill_height"
                            android:background="@drawable/wqx_fn_pill_button"
                            android:duplicateParentState="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lid_chin_row"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="3dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:minHeight="@dimen/lid_chin_min_height"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="6dp">

                <org.liberty.android.nc1020emu.WqxBrandEmblemView
                    android:id="@+id/wqx_chin_emblem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <org.liberty.android.nc1020emu.WqxOnOffButtonView
                    android:id="@+id/btn_onoff"
                    android:layout_width="@dimen/onoff_assembly_size"
                    android:layout_height="@dimen/onoff_assembly_size" />

                <TextView
                    android:id="@+id/lid_chin_url"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:singleLine="true"
                    android:text="www.ggv.com.cn"
                    android:textColor="@color/wqx_speaker_url"
                    android:textSize="8.5sp"
                    android:visibility="gone" />
            </LinearLayout>
        </org.liberty.android.nc1020emu.WqxUpperLidLayout>

        <!-- Vertical Two-Tone Clamshell Hinge -->
        <org.liberty.android.nc1020emu.WqxHingeView
            android:id="@+id/wqx_hinge"
            android:layout_width="13dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="4dp" />

        <!-- Right Clamshell Base (Speaker Grille + Vector 5x10 Keypad + Blue Latch) -->
        <org.liberty.android.nc1020emu.WqxLowerDeckLayout
            android:id="@+id/lower_deck_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.53"
            android:background="@drawable/wqx_lower_deck_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingTop="6dp"
            android:paddingEnd="7dp"
            android:paddingBottom="6dp">

            <org.liberty.android.nc1020emu.WqxSpeakerGrilleView
                android:id="@+id/wqx_speaker_grille"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp" />

            <!-- Brushed-Silver [Speaker + F1..F4 + ON/OFF] Deck Bar for "Full LCD" Skin -->
            <LinearLayout
                android:id="@+id/wqx_deck_fn_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/deck_fn_bar_height"
                android:layout_marginBottom="4dp"
                android:background="@drawable/wqx_speaker_panel_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:visibility="gone">

                <org.liberty.android.nc1020emu.WqxSpeakerDotsView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2" />

                <LinearLayout
                    android:id="@+id/btn_deck_f1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/keypad_button"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:duplicateParentState="true"
                        android:singleLine="true"
                        android:text="F1 插入"
                        android:textColor="@color/wqx_fn_label_text"
                        android:textSize="@dimen/function_label_text_size"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="@dimen/function_pill_width"
                        android:layout_height="@dimen/function_pill_height"
                        android:background="@drawable/wqx_fn_pill_button"
                        android:duplicateParentState="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_deck_f2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/keypad_button"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:duplicateParentState="true"
                        android:singleLine="true"
                        android:text="F2 删除"
                        android:textColor="@color/wqx_fn_label_text"
                        android:textSize="@dimen/function_label_text_size"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="@dimen/function_pill_width"
                        android:layout_height="@dimen/function_pill_height"
                        android:background="@drawable/wqx_fn_pill_button"
                        android:duplicateParentState="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_deck_f3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/keypad_button"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:duplicateParentState="true"
                        android:singleLine="true"
                        android:text="F3 查找"
                        android:textColor="@color/wqx_fn_label_text"
                        android:textSize="@dimen/function_label_text_size"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="@dimen/function_pill_width"
                        android:layout_height="@dimen/function_pill_height"
                        android:background="@drawable/wqx_fn_pill_button"
                        android:duplicateParentState="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_deck_f4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/keypad_button"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:duplicateParentState="true"
                        android:singleLine="true"
                        android:text="F4 修改"
                        android:textColor="@color/wqx_fn_label_text"
                        android:textSize="@dimen/function_label_text_size"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="@dimen/function_pill_width"
                        android:layout_height="@dimen/function_pill_height"
                        android:background="@drawable/wqx_fn_pill_button"
                        android:duplicateParentState="true" />
                </LinearLayout>

                <org.liberty.android.nc1020emu.WqxOnOffButtonView
                    android:id="@+id/btn_deck_onoff"
                    android:layout_width="@dimen/deck_onoff_size"
                    android:layout_height="@dimen/deck_onoff_size"
                    android:layout_marginStart="2dp" />
            </LinearLayout>

            <org.liberty.android.nc1020emu.KeypadLayout
                android:id="@+id/keypad_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:id="@+id/wqx_chin_latch"
                android:layout_width="34dp"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/wqx_chin_latch_bg" />
        </org.liberty.android.nc1020emu.WqxLowerDeckLayout>

    </LinearLayout>

</LinearLayout>
